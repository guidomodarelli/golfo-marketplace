{
  "name": "golfo-marketplace",
  "private": true,
  "description": "Multi-provider marketplace of skills and plugins for AI agents.",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "create-version": "node scripts/create-version.js",
    "cv": "node scripts/create-version.js",
    "check-version-bump": "node scripts/check-version-bump.js",
    "compat:render": "node scripts/render-compatibility-report.js",
    "compat:validate": "node scripts/validate-compatibility-report.js",
    "validate-portable-plugins": "node scripts/validate-portable-plugins.js",
    "test": "pnpm run test:shell && pnpm run test:agent-ready && pnpm run test:bootstrap && pnpm run test:review-fix-loop && pnpm run test:sibling-worktree && pnpm run test:skill-coverage && pnpm run test:agent-ready-launcher && pnpm run test:user-manual && pnpm run test:browser",
    "test:review-fix-loop": "bash plugins/golfo-kit/skills/review-fix-loop/tests/review-fix-loop.test.sh",
    "test:sibling-worktree": "bash plugins/golfo-kit/skills/sibling-worktree/tests/sibling-worktree.test.sh",
    "test:skill-coverage": "node --test \"plugins/golfo-kit/tools/skill-coverage/tests/*.test.mjs\"",
    "test:agent-ready-launcher": "node --test \"packages/agent-ready/test/*.test.mjs\"",
    "test:user-manual": "node --test \"plugins/golfo-kit/skills/user-manual/tests/*.test.mjs\"",
    "test:jira-ticket": "python3 -m pytest -q plugins/golfo-kit/skills/jira-ticket/scripts/tests",
    "setup:browser-tests": "python3 -m venv node_modules/.browser-tests-venv && node_modules/.browser-tests-venv/bin/python -m pip install -r plugins/golfo-kit/skills/agent-ready-setup/scripts/requirements-browser.txt",
    "test:browser": "node_modules/.browser-tests-venv/bin/python plugins/golfo-kit/skills/agent-ready-setup/tests/browser-tools.spec.py",
    "test:shell": "LC_ALL=C.UTF-8 BATS_TEST_TIMEOUT=30 bats tests/create-version.bats tests/check-version-bump.bats tests/validate-compatibility-report.bats tests/validate-portable-plugins.bats tests/detect-test-areas.bats plugins/golfo-kit/skills/codex-autofix-loop/tests/wait-for-pr-event.bats plugins/golfo-kit/skills/codex-comment-closeout/tests/closeout.bats plugins/golfo-kit/skills/user-manual/tests/check-design-tokens.bats skill-eval-runner/tests/run-evals-env-contract.bats skill-eval-runner/tests/run-evals-assertions.bats skill-eval-runner/tests/run-evals-skill-isolation.bats skill-eval-runner/tests/install.bats",
    "test:agent-ready": "LC_ALL=C.UTF-8 BATS_TEST_TIMEOUT=30 bats plugins/golfo-kit/skills/agent-ready-setup/tests/merge-instructions.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-state.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-detection.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-packs.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-updates.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-config.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-cli.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-reviews.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-golfo-kit.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-conflicts.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-pack-tools.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-pack-clis.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-pack-scripts.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-pack-examples.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-blocks.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-workspaces.bats plugins/golfo-kit/skills/agent-ready-setup/tests/agent-ready-ci.bats",
    "test:bootstrap": "LC_ALL=C.UTF-8 BATS_TEST_TIMEOUT=120 bats plugins/golfo-kit/skills/agent-ready-setup/tests/bootstrap.bats"
  },
  "devDependencies": {
    "@babel/parser": "7.29.2",
    "bats": "1.13.0",
    "playwright-core": "1.64.1",
    "yaml": "2.9.1"
  }
}
