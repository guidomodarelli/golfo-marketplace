{
  "description": "Refreshes the file-count marker of the open PR body after every git push (pr-description-template).",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/refresh-pr-file-count.sh\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
