{
  "description": "Frena las respuestas a hilos y comentarios de PR que no usan los templates de codex-comment-closeout o inline-thread-autofix.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-reply-template.mjs"],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "if": "PowerShell(gh *)",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-pr-reply-template.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
