#!/usr/bin/env python3
"""agent-ready-merge <driver> %O %A %B %P: the Git merge drivers of the learning (agent_ready_merge_drivers.py)."""

import os
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

import agent_ready_merge_drivers as drivers  # noqa: E402

if __name__ == "__main__":
    if len(sys.argv) < 5 or sys.argv[1] not in drivers.MERGERS:
        sys.stderr.write(f"usage: agent-ready-merge <{'|'.join(drivers.MERGERS)}> <base> <ours> <theirs> [<path>]\n")
        sys.exit(2)
    sys.exit(drivers.run(*sys.argv[1:5]))
