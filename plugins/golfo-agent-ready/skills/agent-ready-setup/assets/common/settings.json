{
  "permissions": {
    "allow": [
      "Bash(.agents/hooks/sync-marketplace.sh --provider claude)",
      "Bash(.agents/hooks/check-harness-consistency.sh)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/sync-marketplace.sh --provider claude",
            "statusMessage": "Sincronizando configuración Agent Ready con marketplace…"
          },
          {
            "type": "command",
            "command": "bash .agents/hooks/learning-hook.sh --provider claude --event session-start",
            "statusMessage": "Leyendo lo aprendido del proyecto…"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .agents/hooks/relink-hard-link-views.sh",
            "statusMessage": "Reenlazando vistas de .claude…"
          },
          {
            "type": "command",
            "command": "bash .agents/hooks/learning-hook.sh --provider claude --event prompt",
            "statusMessage": "Registrando el episodio de aprendizaje…"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/check-harness-consistency.sh",
            "statusMessage": "Verificando consistencia de configuración Agent Ready…"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/learning-hook.sh --provider claude --event pre-compact",
            "statusMessage": "Revisando lo aprendido antes de compactar…"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash .agents/hooks/learning-hook.sh --provider claude --event session-end",
            "statusMessage": "Revisando lo aprendido en el chat…"
          }
        ]
      }
    ]
  }
}
