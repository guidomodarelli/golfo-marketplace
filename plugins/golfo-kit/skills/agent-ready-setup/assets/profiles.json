{
  "schemaVersion": 1,
  "baseAssets": "assets/common",
  "profiles": {
    "frontend": {
      "kind": "stack",
      "description": "React and Next.js web frontends.",
      "assets": "assets/stacks/frontend",
      "detect": {
        "supersedes": ["node", "android"],
        "signals": [
          { "type": "package-dependency", "names": ["react", "react-dom", "next"] }
        ]
      }
    },
    "node": {
      "kind": "stack",
      "description": "Node.js services without a React frontend.",
      "assets": "assets/stacks/node",
      "detect": {
        "signals": [
          { "type": "file", "paths": ["package.json"] }
        ]
      }
    },
    "java": {
      "kind": "stack",
      "description": "Java and Kotlin services built with Maven or Gradle.",
      "assets": "assets/stacks/java",
      "detect": {
        "signals": [
          { "type": "file", "paths": ["pom.xml", "build.gradle", "build.gradle.kts", "settings.gradle", "settings.gradle.kts"] }
        ]
      }
    },
    "go": {
      "kind": "stack",
      "description": "Go services.",
      "assets": "assets/stacks/go",
      "detect": {
        "signals": [
          { "type": "file", "paths": ["go.mod"] }
        ]
      }
    },
    "android": {
      "kind": "stack",
      "description": "Android apps in Kotlin or Java built with Gradle and the Android Gradle Plugin.",
      "assets": "assets/stacks/android",
      "detect": {
        "supersedes": ["java"],
        "signals": [
          { "type": "glob", "patterns": ["src/main/AndroidManifest.xml", "*/src/main/AndroidManifest.xml", "*/*/src/main/AndroidManifest.xml"] },
          { "type": "gradle-plugin", "ids": ["com.android.application", "com.android.library"] }
        ]
      }
    },
    "business-flows": {
      "kind": "capability",
      "description": "Rules and a design skill for business flows on web and native clients.",
      "assets": "assets/profiles/business-flows"
    },
    "browser": {
      "kind": "capability",
      "description": "Browser automation tools (agent-browser, Playwright and Chrome DevTools MCP) installed in the user cache and registered for the project.",
      "tools": ["browser"],
      "detect": {
        "signals": [
          { "type": "package-dependency", "names": ["@playwright/test", "playwright", "puppeteer", "cypress"] },
          { "type": "gradle-dependency", "coordinates": ["androidx.webkit:webkit"] }
        ]
      }
    },
    "ci": {
      "kind": "ci",
      "description": "Script .agents/ci/agent-ready-check.sh that runs the CI check; every CI provider calls it.",
      "assets": "assets/ci/common"
    },
    "ci-generic": {
      "kind": "ci",
      "description": "Only the CI script, for a pipeline of any provider.",
      "requires": ["ci"]
    },
    "ci-github": {
      "kind": "ci",
      "description": "GitHub Actions workflow .github/workflows/agent-ready.yml that runs the CI script.",
      "assets": "assets/ci/github",
      "requires": ["ci"]
    },
    "ci-gitlab": {
      "kind": "ci",
      "description": "GitLab job .agents/ci/gitlab-ci.yml, included from a managed block of .gitlab-ci.yml.",
      "assets": "assets/ci/gitlab",
      "requires": ["ci"]
    },
    "ci-jenkins": {
      "kind": "ci",
      "description": "Jenkins stage .agents/ci/jenkins-stage.groovy to copy into the Jenkinsfile, which is never edited.",
      "assets": "assets/ci/jenkins",
      "requires": ["ci"]
    }
  },
  "stackDefaults": {
    "frontend": ["frontend", "browser"],
    "node": ["node", "browser"],
    "java": ["java", "browser"],
    "go": ["go", "browser"],
    "android": ["android"]
  }
}
