# Perfil de jira-ticket. Copiar a ~/.config/jira-ticket/env (no versionar) y completar.
# Valores de ejemplo de una organización ficticia.

# Obligatorias
export JIRA_TICKET_SITE_URL=https://acme.atlassian.net
export JIRA_TICKET_CLOUD_ID=00000000-0000-0000-0000-000000000000
export JIRA_TICKET_PROJECT_KEY=ACME

# Opcionales
export JIRA_TICKET_PROJECT_NAME="ACME Payments"
export JIRA_TICKET_BOARD_ID=101
export JIRA_TICKET_ASSIGNEE_ACCOUNT_ID=000000:00000000-0000-0000-0000-000000000000
# export JIRA_TICKET_STORY_TYPE=Story
# export JIRA_TICKET_TASK_TYPE=Task
# export JIRA_TICKET_SUBTASK_TYPE=Sub-task
export JIRA_TICKET_QUARTER_FIELD=customfield_20002
# export JIRA_TICKET_QUARTER_FORMAT="Q{quarter}/{yy}"
export JIRA_TICKET_START_DATE_FIELD=customfield_20003
export JIRA_TICKET_SPRINT_FIELD=customfield_20001
export JIRA_TICKET_SPRINT_NAME_REGEX='^(?P<year>[0-9]{4})\.Q(?P<quarter>[1-4])\.R[0-9]+\.S[0-9]+$'
# export JIRA_TICKET_SPRINT_ACTIVE_STATE=active
export JIRA_TICKET_REPO_ID_SOURCES=package.json:name,basename
# export JIRA_TICKET_REPO_PREFIXES=acme_,acme-
# export JIRA_TICKET_MEMORY_ORG=payments
# export JIRA_TICKET_MAX_RESULTS=50
